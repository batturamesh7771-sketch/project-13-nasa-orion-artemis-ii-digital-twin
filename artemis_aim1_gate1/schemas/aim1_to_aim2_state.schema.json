{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aim1-to-aim2-state.schema.json",
  "title": "AIM 1 to AIM 2 post-TLI state handoff",
  "description": "Canonical SI-unit contract proposal. The integration must inspect the actual AIM 2 schema and implement a tested adapter; do not silently change the existing AIM 2 API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mission_id",
    "handoff_event",
    "epoch_utc",
    "met_s",
    "time_scale",
    "origin",
    "reference_frame",
    "position_m",
    "velocity_m_s",
    "vehicle_configuration",
    "mass_kg",
    "provenance",
    "model_quality",
    "burn"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mission_id": {
      "type": "string",
      "const": "ARTEMIS_II"
    },
    "handoff_event": {
      "type": "string",
      "const": "POST_TLI_BURN"
    },
    "epoch_utc": {
      "type": "string",
      "format": "date-time",
      "description": "Absolute UTC representation; numerical integration must separately track its internal time scale and conversion."
    },
    "met_s": {
      "type": "number",
      "minimum": 0,
      "description": "Mission elapsed seconds from the configured T0; record source precision for the epoch."
    },
    "time_scale": {
      "type": "string",
      "enum": [
        "UTC",
        "TAI",
        "TT",
        "TDB"
      ],
      "description": "Time scale used internally by the numerical integration/configuration (not the display field epoch_utc, which is always UTC); conversions must be documented."
    },
    "origin": {
      "type": "string",
      "const": "EARTH_CENTER",
      "description": "Vector origin for this contract's position/velocity."
    },
    "reference_frame": {
      "type": "string",
      "minLength": 1,
      "description": "Must name the exact frame realization used by AIM 2, e.g. the project's verified Earth-centered inertial frame. Do not use an ambiguous generic ECI label without frame metadata."
    },
    "position_m": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Position in metres in reference_frame."
    },
    "velocity_m_s": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Velocity in metres per second in reference_frame; frame and epoch must match position_m."
    },
    "attitude": {
      "type": [
        "object",
        "null"
      ],
      "description": "Null unless actually modeled; if present include parameterization, body/reference frames and convention."
    },
    "mass_kg": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Modeled post-TLI Orion plus service-module mass consistent with the vehicle configuration. Do not use an SLS stack mass here."
    },
    "vehicle_configuration": {
      "type": "string",
      "const": "ORION_WITH_EUROPEAN_SERVICE_MODULE"
    },
    "burn": {
      "type": "object",
      "required": [
        "id",
        "duration_s",
        "delta_v_vector_m_s",
        "delta_v_provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "const": "ORION_TLI"
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "delta_v_vector_m_s": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "Must be generated by the modeled burn. The published scalar delta-v alone does not specify the vector direction."
        },
        "delta_v_provenance": {
          "type": "string",
          "enum": [
            "MODEL_OUTPUT",
            "UNAVAILABLE"
          ]
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "state_kind",
        "source_registry_version",
        "parameter_manifest_version"
      ],
      "properties": {
        "state_kind": {
          "type": "string",
          "enum": [
            "MODEL_OUTPUT",
            "PUBLIC_REFERENCE",
            "MODEL_OUTPUT_CALIBRATED_TO_PUBLIC_EVENTS"
          ]
        },
        "source_registry_version": {
          "type": "string"
        },
        "parameter_manifest_version": {
          "type": "string"
        },
        "assumption_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "model_quality": {
      "type": "object",
      "required": [
        "fidelity_tier",
        "uncertainty_summary",
        "validation_status"
      ],
      "properties": {
        "fidelity_tier": {
          "type": "string",
          "enum": [
            "3DOF_REDUCED_ORDER",
            "6DOF",
            "NOT_VALIDATED"
          ]
        },
        "uncertainty_summary": {
          "type": "string"
        },
        "validation_status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "NOT_RUN"
          ]
        },
        "gmat_comparison_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "position_residual_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "velocity_residual_m_s": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
